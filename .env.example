# Required in every environment
NEXT_PUBLIC_SITE_URL="https://onlinepayment.in"

# Required once data pages exist (Phase 1). Phase 0 builds without it.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Revalidation webhook (TECHNICAL §5.2). Min 32 chars.
REVALIDATE_SECRET=""

# IndexNow key for instant Bing/Yandex submission (BUILD-PLAN §5.4)
INDEXNOW_KEY=""

# Ads (TECHNICAL §6). Phase 0 ships with ads off.
ADS_ENABLED="false"
ADS_PROVIDER="noop"
ADSENSE_CLIENT_ID=""

# Analytics
PLAUSIBLE_HOST=""
