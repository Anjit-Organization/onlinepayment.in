# Required in every environment
NEXT_PUBLIC_SITE_URL="https://onlinepayment.in"

# Required once data pages exist (Phase 1). Phase 0 builds without it.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Revalidation webhook (TECHNICAL §5.2). Min 32 chars.
REVALIDATE_SECRET=""

# IndexNow key for instant Bing/Yandex submission (BUILD-PLAN §5.4)
INDEXNOW_KEY=""

# Ads (TECHNICAL §6). Phase 0 ships with ads off.
ADS_ENABLED="false"
ADS_PROVIDER="noop"
ADSENSE_CLIENT_ID=""
# Slot id -> provider unit id. Without an entry a slot renders nothing.
#   AD_UNIT_IDS="in-content-1:1234567890,in-content-2:2345678901,footer:3456789012"
AD_UNIT_IDS=""

# Consent (TECHNICAL §6.5). Ads cannot be enabled while this is "none" —
# the build refuses it. "google" means a GDPR message has been created and
# published in AdSense under Privacy & messaging; it needs no script here.
# "custom" loads a CMP from Google's certified list via CONSENT_CMP_SRC.
CONSENT_PROVIDER="none"
CONSENT_CMP_SRC=""

# Analytics
PLAUSIBLE_HOST=""
